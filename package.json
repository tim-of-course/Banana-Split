{
  "name": "banana-split",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tim-of-course/Banana-Split.git"
  },
  "bugs": {
    "url": "https://github.com/tim-of-course/Banana-Split/issues"
  },
  "homepage": "https://github.com/tim-of-course/Banana-Split#readme",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:windows": "bun scripts/build.ts bun-windows-x64",
    "build:macos": "bun scripts/build.ts bun-darwin-arm64 && bun scripts/build.ts bun-darwin-x64",
    "package:release": "bun scripts/package-release.ts",
    "check": "bun build --target=bun --outfile .banana-test/check.js src/index.ts",
    "test": "bun test",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  }
}
